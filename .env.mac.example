# .env para uso com docker-compose.mac.yml (teste local no Mac/Linux).
# Copie este arquivo para ".env" na mesma pasta (ou exporte essas variáveis
# no terminal antes do "docker compose up").

# Porta no seu Mac para acessar (http://localhost:APP_PORT)
APP_PORT=8080

# Chave aleatória qualquer, so pra teste local pode deixar como está
SECRET_KEY=teste123

# Pastas REAIS no seu Mac com a amostra de PDFs baixada para validar a busca.
# Ajuste para onde você realmente salvou os arquivos.
ENTRADA_HOST=./dados/entrada
SAIDA_HOST=./dados/saida

ENTRADA_PDF=/dados/entrada
SAIDA_PDF=/dados/saida