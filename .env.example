# Porta exposta na rede (acesso: http://ip-do-servidor:APP_PORT)
APP_PORT=80

# Chave secreta do Flask (usada so pra assinar os avisos/flash messages).
# Gere uma string aleatoria qualquer, ex rodando no PowerShell:
#   -join ((48..57)+(65..90)+(97..122)|Get-Random -Count 32|%{[char]$_})
SECRET_KEY=troque-por-uma-string-aleatoria-longa

# Pastas que os usuarios TEM PERMISSAO de digitar no formulario (separadas
# por ;). Caminhos fora daqui sao recusados, mesmo que o container consiga
# ver mais disco do que isso (defesa em profundidade, ver docker-compose.yml).
# Quanto mais especifico, mais seguro. Exemplo minimo:
#   DATA_ROOTS=C:\dados\PDFs;C:\dados\Extraidos
DATA_ROOTS=C:\;D:\